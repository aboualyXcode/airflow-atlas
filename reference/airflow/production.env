# Production settings for a self-managed Airflow 3 deployment, as environment variables.
# Each group names the failure it guards against in the atlas.

# Limits, sized with Operations > Capacity (pool-slots-exhausted, tasks-stuck-queued)
AIRFLOW__CORE__PARALLELISM=128
AIRFLOW__CORE__MAX_ACTIVE_TASKS_PER_DAG=16
AIRFLOW__CORE__MAX_ACTIVE_RUNS_PER_DAG=4
AIRFLOW__CELERY__WORKER_CONCURRENCY=16

# A default timeout, in seconds, for tasks that do not set one (execution-timeout)
AIRFLOW__CORE__DEFAULT_TASK_EXECUTION_TIMEOUT=3600

# Parsing (dag-processing-timeout)
AIRFLOW__CORE__DAGBAG_IMPORT_TIMEOUT=30

# No surprise backfills (catchup-flood)
AIRFLOW__SCHEDULER__CATCHUP_BY_DEFAULT=False

# Remote logs survive dead workers (task-logs-missing)
AIRFLOW__LOGGING__REMOTE_LOGGING=True
AIRFLOW__LOGGING__REMOTE_BASE_LOG_FOLDER=s3://larder-airflow-logs
AIRFLOW__LOGGING__REMOTE_LOG_CONN_ID=aws_default

# Connections and variables from Secrets Manager (connection-not-found)
AIRFLOW__SECRETS__BACKEND=airflow.providers.amazon.aws.secrets.secrets_manager.SecretsManagerBackend
AIRFLOW__SECRETS__BACKEND_KWARGS={"connections_prefix": "airflow/connections", "variables_prefix": "airflow/variables"}

# Small pools per process, behind PgBouncer (db-connections-exhausted)
AIRFLOW__DATABASE__SQL_ALCHEMY_POOL_SIZE=5
AIRFLOW__DATABASE__SQL_ALCHEMY_MAX_OVERFLOW=5

# Metrics for reference/observability/alerts.yaml
AIRFLOW__METRICS__STATSD_ON=True
AIRFLOW__METRICS__STATSD_HOST=statsd-exporter
AIRFLOW__METRICS__STATSD_PORT=9125
AIRFLOW__METRICS__STATSD_PREFIX=airflow
